#!/usr/bin/env bash
set -e
echo "▶ Starting WSL (Ubuntu) bootstrap..."

# Install Ubuntu tools
sudo apt update && sudo apt install -y zsh curl fzf zoxide btop

# Install Oh My Posh
if ! command -v oh-my-posh &> /dev/null; then
    curl -s https://ohmyposh.dev/install.sh | sudo bash -s -- -d /usr/local/bin
fi

# Zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d "$ZINIT_HOME" ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"

# Set Shell
[[ "$SHELL" != *"zsh"* ]] && sudo chsh -s $(which zsh) $(whoami)

echo "✔ WSL bootstrap complete"
