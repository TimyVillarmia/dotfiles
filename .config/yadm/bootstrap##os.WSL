#!/usr/bin/env bash

set -euo pipefail

sudo apt update

sudo apt install -y \
    git \
    zsh \
    curl \
    wget \
    unzip \
    build-essential \
    ca-certificates \
    btop

if ! command -v oh-my-posh >/dev/null 2>&1; then
    curl -s https://ohmyposh.dev/install.sh | sudo bash -s -- -d /usr/local/bin
fi

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null 2>&1; then
    curl -fsSL https://mise.run -o /tmp/install-mise.sh
    sh /tmp/install-mise.sh
    rm /tmp/install-mise.sh
fi

export PATH="$HOME/.local/bin:$PATH"

mise install

ANTIDOTE_DIR="${ZDOTDIR:-$HOME}/.antidote"

if [[ ! -d "$ANTIDOTE_DIR" ]]; then
    git clone \
        --depth=1 \
        https://github.com/mattmc3/antidote.git \
        "$ANTIDOTE_DIR"
fi

ZPLUGINS="$HOME/.zsh_plugins.txt"

if [[ -f "$ANTIDOTE_DIR/antidote.zsh" && -f "$ZPLUGINS" ]]; then
    zsh -c "
        source '$ANTIDOTE_DIR/antidote.zsh'
        antidote bundle < '$ZPLUGINS' > '$HOME/.zsh_plugins.zsh'
    "
fi

THEME="$HOME/.theme.omp.json"

if command -v oh-my-posh >/dev/null 2>&1 && [[ -f "$THEME" ]]; then
    mkdir -p "$HOME/.cache"

    oh-my-posh init zsh \
        --config "$THEME" \
        > "$HOME/.cache/omp-init.zsh"
fi

if command -v zsh >/dev/null 2>&1; then
    TARGET_SHELL="$(command -v zsh)"

    if [[ "$SHELL" != "$TARGET_SHELL" ]]; then
        sudo chsh -s "$TARGET_SHELL" "$USER"
    fi
fi
