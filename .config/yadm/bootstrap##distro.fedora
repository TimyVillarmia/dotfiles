#!/usr/bin/env bash
set -e

echo "▶ Fedora bootstrap starting..."

sudo dnf upgrade -y --refresh

sudo dnf install -y \
git \
zsh \
curl \
wget \
fzf \
ripgrep \
fd \
bat \
eza \
zoxide \
btop \
neovim \
fastfetch

# Oh My Posh
if ! command -v oh-my-posh &> /dev/null; then
  curl -s https://ohmyposh.dev/install.sh | bash -s
fi

# Zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Nerd Font
FONT_DIR="$HOME/.local/share/fonts"
mkdir -p "$FONT_DIR"
if ! fc-list | grep -qi "JetBrainsMono Nerd Font"; then
  curl -fLo "$FONT_DIR/JetBrainsMonoNerdFont-Regular.ttf" \
  https://github.com/ryanoasis/nerd-fonts/raw/master/patched-fonts/JetBrainsMono/Regular/JetBrainsMonoNerdFont-Regular.ttf
  fc-cache -fv
fi

# Default shell to zsh
if [[ "$SHELL" != *"zsh"* ]]; then
  chsh -s $(which zsh)
fi

echo "✔ Fedora bootstrap complete"
